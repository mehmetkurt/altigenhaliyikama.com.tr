---
import BaseLayout from '@layouts/BaseLayout.astro';
import PickupRequestForm from '@components/sections/PickupRequestForm.astro';
import { SITE, getWhatsAppUrl } from '@config/site';
import { getAllRegions, getAllServices } from '@services/content';
import { buildBreadcrumbSchema } from '@utils/schema';

const [services, regions] = await Promise.all([
  getAllServices(),
  getAllRegions(),
]);

const whatsappHref = getWhatsAppUrl();

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Ana Sayfa', path: '/' },
  { name: 'İletişim', path: '/iletisim' },
]);
---

<BaseLayout
  title={`İletişim ve Servis Randevusu | ${SITE.name}`}
  description="Altıgen Halı Yıkama telefon, WhatsApp hattı, çalışma saatleri ve ücretsiz adresten alım randevu formu."
  canonicalPath="/iletisim"
  schemas={[breadcrumbSchema]}
>
  <section class="bg-brand-sand/70 border-b border-brand-stone/80 py-12 md:py-16">
    <div class="container-site max-w-5xl space-y-4">
      <nav aria-label="Sayfa Konumu" class="text-xs text-brand-muted flex items-center gap-2">
        <a href="/" class="hover:text-brand-ink">Ana Sayfa</a>
        <span aria-hidden="true">/</span>
        <span class="text-brand-ink font-medium">İletişim</span>
      </nav>
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand-teal">
        Hızlı Ulaşım & Randevu
      </p>
      <h1 class="text-3xl sm:text-4xl font-bold leading-tight">
        İletişim ve Ücretsiz Servis Talebi
      </h1>
      <p class="text-base sm:text-lg text-brand-slate max-w-2xl">
        Aşağıdaki form üzerinden birkaç saniyede servis talebi oluşturabilir veya
        doğrudan telefon ve WhatsApp hattımızdan bize ulaşabilirsiniz.
      </p>
    </div>
  </section>

  <section class="section-space">
    <div class="container-site max-w-5xl grid grid-cols-1 gap-8 lg:grid-cols-12 items-start">
      <div class="lg:col-span-7">
        <PickupRequestForm services={services} regions={regions} />
      </div>

      <aside class="lg:col-span-5 space-y-5">
        <div class="surface-card p-6 space-y-4">
          <h2 class="text-lg font-bold">Doğrudan İletişim Kanalları</h2>

          <dl class="space-y-4 text-sm">
            <div>
              <dt class="text-xs font-medium text-brand-muted">Telefon</dt>
              <dd class="mt-0.5">
                <a
                  href={SITE.contact.phoneHref}
                  class="font-display text-lg font-bold text-brand-ink hover:text-brand-teal transition-colors"
                >
                  {SITE.contact.phoneDisplay}
                </a>
              </dd>
            </div>

            <div>
              <dt class="text-xs font-medium text-brand-muted">WhatsApp Hattı</dt>
              <dd class="mt-1">
                <a
                  href={whatsappHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 font-semibold text-brand-teal hover:text-brand-teal-dark"
                >
                  <span>WhatsApp ile Mesaj Gönder</span>
                  <span aria-hidden="true">→</span>
                </a>
              </dd>
            </div>

            <div>
              <dt class="text-xs font-medium text-brand-muted">E-posta</dt>
              <dd class="mt-0.5">
                <a
                  href={`mailto:${SITE.contact.email}`}
                  class="text-brand-ink hover:text-brand-teal transition-colors"
                >
                  {SITE.contact.email}
                </a>
              </dd>
            </div>

            <div>
              <dt class="text-xs font-medium text-brand-muted">Çalışma Saatleri</dt>
              <dd class="mt-0.5 text-brand-slate">
                {SITE.contact.workingHours.display}
              </dd>
            </div>

            <div>
              <dt class="text-xs font-medium text-brand-muted">Adres</dt>
              <dd class="mt-0.5 text-brand-slate">
                {SITE.contact.address.street}, {SITE.contact.address.district} / {SITE.contact.address.city}
              </dd>
            </div>
          </dl>
        </div>

        <div class="rounded-2xl bg-brand-sand/80 border border-brand-stone p-6 space-y-3">
          <h2 class="text-base font-bold">Önce tahmini tutar mı görmek istersiniz?</h2>
          <p class="text-sm text-brand-slate">
            Halı ölçünüzü girerek ortalama yıkama tutarını anında hesaplayabilirsiniz.
          </p>
          <a href="/fiyatlar" class="btn-secondary w-full">
            Fiyat Hesaplayıcıya Git
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
