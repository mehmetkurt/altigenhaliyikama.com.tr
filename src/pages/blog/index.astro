---
import BaseLayout from '@layouts/BaseLayout.astro';
import { SITE } from '@config/site';
import { getAllBlogPosts } from '@services/content';
import { buildBreadcrumbSchema } from '@utils/schema';

const posts = await getAllBlogPosts();

const formatDate = (isoDate: string) =>
  new Date(isoDate).toLocaleDateString('tr-TR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Halı Bakım Rehberi', path: '/blog' },
]);
---

<BaseLayout
  title={`Halı ve Tekstil Bakım Rehberi | ${SITE.name}`}
  description="Evde halı lekesine ilk müdahale, yün ve el dokuma halı bakımı, kapalı kurutma hijyeni ve ev tekstili temizliği hakkında uzman rehberler."
  canonicalPath="/blog"
  schemas={[breadcrumbSchema]}
>
  <section class="bg-brand-sand/70 border-b border-brand-stone/80 py-12 md:py-16">
    <div class="container-site max-w-5xl space-y-4">
      <nav aria-label="Sayfa Konumu" class="text-xs text-brand-muted flex items-center gap-2">
        <a href="/" class="hover:text-brand-ink">Ana Sayfa</a>
        <span aria-hidden="true">/</span>
        <span class="text-brand-ink font-medium">Bakım Rehberi</span>
      </nav>
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand-teal">
        Uzman Bilgi Merkezi
      </p>
      <h1 class="text-3xl sm:text-4xl font-bold leading-tight">
        Halı ve Tekstil Bakım Rehberi
      </h1>
      <p class="text-base sm:text-lg text-brand-slate max-w-2xl">
        Halılarınızın dokusunu, rengini ve evinizin hijyenini korumak için pratik
        ve güvenilir bakım önerileri.
      </p>
    </div>
  </section>

  <section class="section-space">
    <div class="container-site max-w-5xl">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {posts.map((post) => (
          <article class="surface-card p-6 flex flex-col justify-between gap-6">
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2 text-xs text-brand-muted">
                <span class="font-semibold text-brand-teal">{post.data.category}</span>
                <span>{post.data.readingMinutes} dk okuma</span>
              </div>
              <h2 class="text-lg font-bold leading-snug text-brand-ink">
                <a
                  href={`/blog/${post.data.slug}`}
                  class="hover:text-brand-teal transition-colors"
                >
                  {post.data.title}
                </a>
              </h2>
              <p class="text-sm text-brand-slate leading-relaxed">
                {post.data.excerpt}
              </p>
            </div>

            <div class="pt-4 border-t border-brand-stone/80 flex items-center justify-between text-xs">
              <time datetime={post.data.publishedAt} class="text-brand-muted">
                {formatDate(post.data.publishedAt)}
              </time>
              <a
                href={`/blog/${post.data.slug}`}
                class="font-semibold text-brand-teal hover:text-brand-teal-dark"
              >
                Oku →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
