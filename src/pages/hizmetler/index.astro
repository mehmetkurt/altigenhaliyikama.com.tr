---
import BaseLayout from '@layouts/BaseLayout.astro';
import { SITE } from '@config/site';
import { getAllServices } from '@services/content';
import { buildBreadcrumbSchema } from '@utils/schema';

const services = await getAllServices();

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Hizmetler', path: '/hizmetler' },
]);
---

<BaseLayout
  title={`Hizmetlerimiz | ${SITE.name}`}
  description="Halı yıkama, yerinde koltuk yıkama, stor/zebra perde yıkama ve kişiye özel tekil yorgan-battaniye yıkama hizmetlerimiz."
  canonicalPath="/hizmetler"
  schemas={[breadcrumbSchema]}
>
  <section class="bg-brand-sand/70 border-b border-brand-stone/80 py-12 md:py-16">
    <div class="container-site max-w-5xl space-y-4">
      <nav aria-label="Sayfa Konumu" class="text-xs text-brand-muted flex items-center gap-2">
        <a href="/" class="hover:text-brand-ink">Ana Sayfa</a>
        <span aria-hidden="true">/</span>
        <span class="text-brand-ink font-medium">Hizmetler</span>
      </nav>
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand-teal">
        Hizmet Kataloğu
      </p>
      <h1 class="text-3xl sm:text-4xl font-bold leading-tight">
        Profesyonel Halı ve Ev Tekstili Yıkama Hizmetleri
      </h1>
      <p class="text-base sm:text-lg text-brand-slate max-w-2xl">
        Her kumaş ve halı türü için ayrı program, bitkisel şampuan ve kontrollü
        kurutma standartları uyguluyoruz.
      </p>
    </div>
  </section>

  <section class="section-space">
    <div class="container-site max-w-5xl space-y-6">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {services.map((service) => (
          <article class="surface-card p-6 sm:p-7 flex flex-col justify-between gap-6">
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2 text-xs font-medium text-brand-muted">
                <span>{service.unitLabel}</span>
                <span>{service.turnaroundText}</span>
              </div>
              <h2 class="text-xl font-bold text-brand-ink">
                <a
                  href={`/hizmetler/${service.slug}`}
                  class="hover:text-brand-teal transition-colors"
                >
                  {service.title}
                </a>
              </h2>
              <p class="text-sm sm:text-base text-brand-slate leading-relaxed">
                {service.shortDescription}
              </p>
              <ul class="pt-2 space-y-1.5 text-sm text-brand-slate">
                {service.highlights.slice(0, 2).map((h) => (
                  <li class="flex items-start gap-2">
                    <span aria-hidden="true" class="text-brand-teal font-bold">✓</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-4 border-t border-brand-stone/80 flex items-center justify-between">
              <a
                href={`/hizmetler/${service.slug}`}
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-teal hover:text-brand-teal-dark"
              >
                <span>Detaylı Süreç</span>
                <span aria-hidden="true">→</span>
              </a>
              <a
                href="/fiyatlar"
                class="text-xs font-medium text-brand-muted hover:text-brand-ink"
              >
                Fiyatları Gör
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
