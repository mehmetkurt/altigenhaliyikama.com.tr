---
import BaseLayout from '@layouts/BaseLayout.astro';
import { SITE, getWhatsAppUrl } from '@config/site';
import { getAllServices, type ServiceItem } from '@services/content';
import { buildBreadcrumbSchema, buildServiceSchema } from '@utils/schema';

export async function getStaticPaths() {
  const services = await getAllServices();
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;
const whatsappHref = getWhatsAppUrl(
  `Merhaba, ${service.title} hizmetiniz hakkında bilgi ve randevu almak istiyorum.`
);

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Ana Sayfa', path: '/' },
  { name: 'Hizmetler', path: '/#hizmetler' },
  { name: service.title, path: `/hizmetler/${service.slug}` },
]);
---

<BaseLayout
  title={service.seoTitle}
  description={service.seoDescription}
  canonicalPath={`/hizmetler/${service.slug}`}
  schemas={[buildServiceSchema(service), breadcrumbSchema]}
>
  <article class="section-space">
    <div class="container-site max-w-4xl space-y-10">
      <nav aria-label="Sayfa Konumu" class="text-xs text-brand-muted flex items-center gap-2">
        <a href="/" class="hover:text-brand-ink">Ana Sayfa</a>
        <span aria-hidden="true">/</span>
        <a href="/#hizmetler" class="hover:text-brand-ink">Hizmetler</a>
        <span aria-hidden="true">/</span>
        <span class="text-brand-ink font-medium">{service.title}</span>
      </nav>

      <header class="space-y-4">
        <div class="flex flex-wrap items-center gap-3 text-xs font-semibold text-brand-teal">
          <span>{service.unitLabel}</span>
          <span aria-hidden="true">•</span>
          <span>{service.turnaroundText}</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold leading-tight">
          {service.title}
        </h1>
        <p class="text-base sm:text-lg text-brand-slate leading-relaxed">
          {service.fullDescription}
        </p>
      </header>

      <section class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div class="surface-card p-6 space-y-4">
          <h2 class="text-lg font-bold">Hizmet Avantajları</h2>
          <ul class="space-y-2.5 text-sm sm:text-base text-brand-slate">
            {service.highlights.map((item) => (
              <li class="flex items-start gap-2.5">
                <span aria-hidden="true" class="text-brand-teal font-bold mt-0.5">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="surface-card p-6 space-y-4">
          <h2 class="text-lg font-bold">Uygulama Aşamaları</h2>
          <ol class="space-y-3 text-sm sm:text-base text-brand-slate">
            {service.processSteps.map((step, index) => (
              <li class="flex items-start gap-3">
                <span class="font-display text-xs font-bold text-brand-teal bg-brand-teal-tint px-2 py-1 rounded-md shrink-0">
                  0{index + 1}
                </span>
                <span>{step}</span>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <div class="rounded-2xl bg-brand-sand border border-brand-stone p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h2 class="text-lg font-bold">{service.title} için randevu alın</h2>
          <p class="text-sm text-brand-slate mt-1">
            Ücretsiz adres servisi ve net fiyat bilgisi için hemen ulaşabilirsiniz.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 shrink-0">
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
          >
            WhatsApp Randevu
          </a>
          <a href={SITE.contact.phoneHref} class="btn-secondary">
            {SITE.contact.phoneDisplay}
          </a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
