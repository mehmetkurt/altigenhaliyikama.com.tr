---
import { SITE } from '@config/site';
import BrandLogo from '@components/ui/BrandLogo.astro';
import { getAllRegions, getAllServices } from '@services/content';

const [services, regions] = await Promise.all([
  getAllServices(),
  getAllRegions(),
]);

const currentYear = new Date().getFullYear();
---

<footer class="bg-brand-ink text-slate-300 pb-24 md:pb-12 pt-16 border-t border-slate-800">
  <div class="container-site">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12 pb-12 border-b border-slate-800">
      <div class="md:col-span-4 space-y-4">
        <a href="/" aria-label={SITE.name}>
          <BrandLogo inverted />
        </a>
        <p class="text-sm leading-relaxed text-slate-300/90 max-w-sm">
          {SITE.description}
        </p>
        <p class="text-xs text-slate-400">
          {SITE.contact.workingHours.display}
        </p>
      </div>

      <div class="md:col-span-3 space-y-3">
        <h2 class="font-display text-sm font-semibold uppercase tracking-wider text-white">
          Hizmetlerimiz
        </h2>
        <ul class="space-y-2.5 text-sm">
          {services.map((service) => (
            <li>
              <a
                href={`/hizmetler/${service.slug}`}
                class="hover:text-white transition-colors"
              >
                {service.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-2 space-y-3">
        <h2 class="font-display text-sm font-semibold uppercase tracking-wider text-white">
          Bölgeler
        </h2>
        <ul class="space-y-2.5 text-sm">
          {regions.map((region) => (
            <li>
              <a
                href={`/bolgeler/${region.slug}`}
                class="hover:text-white transition-colors"
              >
                {region.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-3 space-y-3">
        <h2 class="font-display text-sm font-semibold uppercase tracking-wider text-white">
          İletişim
        </h2>
        <address class="not-italic space-y-2 text-sm">
          <p>
            <a
              href={SITE.contact.phoneHref}
              class="font-semibold text-white hover:text-teal-300 transition-colors"
            >
              {SITE.contact.phoneDisplay}
            </a>
          </p>
          <p>
            <a
              href={`mailto:${SITE.contact.email}`}
              class="hover:text-white transition-colors"
            >
              {SITE.contact.email}
            </a>
          </p>
          <p class="text-slate-400">
            {SITE.contact.address.district}, {SITE.contact.address.city}
          </p>
        </address>
      </div>
    </div>

    <div class="pt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between text-xs text-slate-400">
      <p>© {currentYear} {SITE.legalName}. Tüm hakları saklıdır.</p>
      <div class="flex items-center gap-4">
        <a href="/sitemap-index.xml" class="hover:text-white transition-colors">
          Site Haritası
        </a>
        <a href="/llms.txt" class="hover:text-white transition-colors">
          llms.txt
        </a>
      </div>
    </div>
  </div>
</footer>
