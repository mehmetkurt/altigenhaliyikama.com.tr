---
import { SITE, getWhatsAppUrl } from '@config/site';

const whatsappHref = getWhatsAppUrl();
---

<aside
  aria-label="Hızlı İletişim Çubuğu"
  class="fixed inset-x-0 bottom-0 z-40 md:hidden border-t border-brand-stone bg-white/95 backdrop-blur-md px-3 py-2.5 shadow-[0_-8px_24px_-12px_rgba(15,41,66,0.18)]"
>
  <div class="grid grid-cols-2 gap-2.5 max-w-md mx-auto">
    <a
      href={SITE.contact.phoneHref}
      class="btn-secondary !min-h-12 !px-3 !text-sm w-full"
    >
      <svg class="h-4 w-4 shrink-0 text-brand-teal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
      </svg>
      <span>Hemen Ara</span>
    </a>

    <a
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-primary !min-h-12 !px-3 !text-sm w-full"
    >
      <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
      </svg>
      <span>WhatsApp</span>
    </a>
  </div>
</aside>
