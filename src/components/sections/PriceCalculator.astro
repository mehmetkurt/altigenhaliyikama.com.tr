---
import { SITE } from '@config/site';
import type { PricingItem } from '@services/content';

export interface Props {
  items: PricingItem[];
}

const { items } = Astro.props;
const calculableItems = items.filter((item) => item.calculable);
---

<section
  id="fiyat-hesaplayici"
  class="surface-card p-6 sm:p-8 space-y-6"
  data-whatsapp={SITE.contact.whatsappNumber}
>
  <div class="space-y-1.5">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand-teal">
      Anlık Tahmini Tutar Hesaplayıcı
    </p>
    <h2 class="text-xl sm:text-2xl font-bold">
      Halı ve hizmet tutarınızı hemen hesaplayın
    </h2>
    <p class="text-sm text-brand-slate">
      Ölçü (En × Boy) veya doğrudan m² / adet girerek birden fazla ürünü listeye
      ekleyebilir, sonucu tek dokunuşla WhatsApp üzerinden iletebilirsiniz.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-12 items-end">
    <div class="sm:col-span-5 space-y-1.5">
      <label for="calc-service" class="block text-xs font-semibold text-brand-ink">
        Hizmet / Halı Türü
      </label>
      <select id="calc-service" class="form-field">
        {calculableItems.map((item) => (
          <option
            value={item.id}
            data-name={item.name}
            data-price={item.price}
            data-unit={item.unit}
            data-unit-label={item.unitLabel}
          >
            {item.name} — {item.price} TL / {item.unitLabel}
          </option>
        ))}
      </select>
    </div>

    <div id="calc-m2-inputs" class="sm:col-span-5 grid grid-cols-2 gap-3">
      <div class="space-y-1.5">
        <label for="calc-width" class="block text-xs font-semibold text-brand-ink">
          En (metre)
        </label>
        <input
          id="calc-width"
          type="number"
          inputmode="decimal"
          min="0.5"
          max="20"
          step="0.1"
          value="2"
          class="form-field"
        />
      </div>
      <div class="space-y-1.5">
        <label for="calc-length" class="block text-xs font-semibold text-brand-ink">
          Boy (metre)
        </label>
        <input
          id="calc-length"
          type="number"
          inputmode="decimal"
          min="0.5"
          max="20"
          step="0.1"
          value="3"
          class="form-field"
        />
      </div>
    </div>

    <div id="calc-qty-input" class="hidden sm:col-span-5 space-y-1.5">
      <label for="calc-qty" class="block text-xs font-semibold text-brand-ink">
        Adet / Takım Sayısı
      </label>
      <input
        id="calc-qty"
        type="number"
        inputmode="numeric"
        min="1"
        max="20"
        step="1"
        value="1"
        class="form-field"
      />
    </div>

    <div class="sm:col-span-2">
      <button id="calc-add-btn" type="button" class="btn-primary w-full">
        Listeye Ekle
      </button>
    </div>
  </div>

  <div class="rounded-xl bg-brand-sand/70 border border-brand-stone p-4 sm:p-5 space-y-4">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-sm font-bold text-brand-ink">Hesaplama Özeti</h3>
      <button
        id="calc-clear-btn"
        type="button"
        class="hidden text-xs font-medium text-brand-muted hover:text-brand-ink underline"
      >
        Listeyi Temizle
      </button>
    </div>

    <ul id="calc-list" class="space-y-2 text-sm text-brand-slate">
      <li class="text-brand-muted">
        Henüz ürün eklenmedi. Yukarıdan hizmet seçip “Listeye Ekle” butonuna basın.
      </li>
    </ul>

    <div class="pt-4 border-t border-brand-stone flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <p class="text-xs text-brand-muted">Tahmini Toplam Tutar</p>
        <p id="calc-total" class="font-display text-2xl font-bold text-brand-ink">
          0 TL
        </p>
      </div>

      <a
        id="calc-whatsapp-btn"
        href={`https://wa.me/${SITE.contact.whatsappNumber}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary pointer-events-none opacity-50"
        aria-disabled="true"
      >
        Bu Hesaplamayla WhatsApp’tan Randevu Al
      </a>
    </div>
  </div>

  <p class="text-xs text-brand-muted leading-relaxed">
    * Gösterilen tutar bilgilendirme amaçlı tahmini hesaplamadır. Kesin ölçüm,
    teslim alım sırasında netleştirilir. Ücretsiz adres servisi dahildir.
  </p>
</section>

<script is:inline>
  (() => {
    const root = document.getElementById('fiyat-hesaplayici');
    if (!root) return;

    const whatsappNumber = root.getAttribute('data-whatsapp') || '';
    const select = document.getElementById('calc-service');
    const m2Box = document.getElementById('calc-m2-inputs');
    const qtyBox = document.getElementById('calc-qty-input');
    const widthInput = document.getElementById('calc-width');
    const lengthInput = document.getElementById('calc-length');
    const qtyInput = document.getElementById('calc-qty');
    const addBtn = document.getElementById('calc-add-btn');
    const clearBtn = document.getElementById('calc-clear-btn');
    const listEl = document.getElementById('calc-list');
    const totalEl = document.getElementById('calc-total');
    const waBtn = document.getElementById('calc-whatsapp-btn');

    if (
      !(select instanceof HTMLSelectElement) ||
      !m2Box ||
      !qtyBox ||
      !(widthInput instanceof HTMLInputElement) ||
      !(lengthInput instanceof HTMLInputElement) ||
      !(qtyInput instanceof HTMLInputElement) ||
      !addBtn ||
      !clearBtn ||
      !listEl ||
      !totalEl ||
      !(waBtn instanceof HTMLAnchorElement)
    ) {
      return;
    }

    /** @type {Array<{id: string, name: string, detail: string, subtotal: number}>} */
    let entries = [];

    const syncUnitFields = () => {
      const option = select.selectedOptions[0];
      const isM2 = option?.dataset.unit === 'm2';
      m2Box.classList.toggle('hidden', !isM2);
      qtyBox.classList.toggle('hidden', isM2);
    };

    const formatTRY = (amount) =>
      `${Math.round(amount).toLocaleString('tr-TR')} TL`;

    const render = () => {
      listEl.innerHTML = '';

      if (entries.length === 0) {
        const empty = document.createElement('li');
        empty.className = 'text-brand-muted';
        empty.textContent =
          'Henüz ürün eklenmedi. Yukarıdan hizmet seçip “Listeye Ekle” butonuna basın.';
        listEl.appendChild(empty);
        totalEl.textContent = '0 TL';
        clearBtn.classList.add('hidden');
        waBtn.classList.add('pointer-events-none', 'opacity-50');
        waBtn.setAttribute('aria-disabled', 'true');
        return;
      }

      let grandTotal = 0;

      entries.forEach((entry, index) => {
        grandTotal += entry.subtotal;

        const li = document.createElement('li');
        li.className =
          'flex items-center justify-between gap-3 rounded-lg bg-white border border-brand-stone/80 px-3.5 py-2.5';

        const left = document.createElement('div');
        const title = document.createElement('p');
        title.className = 'font-medium text-brand-ink';
        title.textContent = entry.name;
        const meta = document.createElement('p');
        meta.className = 'text-xs text-brand-muted';
        meta.textContent = entry.detail;
        left.append(title, meta);

        const right = document.createElement('div');
        right.className = 'flex items-center gap-3 shrink-0';

        const priceSpan = document.createElement('span');
        priceSpan.className = 'font-semibold text-brand-ink';
        priceSpan.textContent = formatTRY(entry.subtotal);

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className =
          'text-xs text-brand-muted hover:text-red-700 px-1.5 py-1';
        removeBtn.setAttribute('aria-label', `${entry.name} satırını kaldır`);
        removeBtn.textContent = '×';
        removeBtn.addEventListener('click', () => {
          entries.splice(index, 1);
          render();
        });

        right.append(priceSpan, removeBtn);
        li.append(left, right);
        listEl.appendChild(li);
      });

      totalEl.textContent = formatTRY(grandTotal);
      clearBtn.classList.remove('hidden');

      const summaryLines = entries.map(
        (e) => `- ${e.name} (${e.detail}): ${formatTRY(e.subtotal)}`
      );
      const message = [
        'Merhaba, web sitenizdeki hesaplayıcı üzerinden tahmini tutar oluşturdum:',
        '',
        ...summaryLines,
        '',
        `Tahmini Toplam: ${formatTRY(grandTotal)}`,
        'Servis randevusu hakkında bilgi alabilir miyim?',
      ].join('\n');

      waBtn.href = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
      waBtn.classList.remove('pointer-events-none', 'opacity-50');
      waBtn.setAttribute('aria-disabled', 'false');
    };

    select.addEventListener('change', syncUnitFields);

    addBtn.addEventListener('click', () => {
      const option = select.selectedOptions[0];
      if (!option) return;

      const name = option.dataset.name || option.textContent || 'Hizmet';
      const unitPrice = Number(option.dataset.price || 0);
      const unit = option.dataset.unit || 'adet';
      const unitLabel = option.dataset.unitLabel || 'Adet';

      if (unit === 'm2') {
        const w = Math.max(0.5, Number(widthInput.value) || 0);
        const l = Math.max(0.5, Number(lengthInput.value) || 0);
        const area = Number((w * l).toFixed(2));
        entries.push({
          id: `${option.value}-${Date.now()}`,
          name,
          detail: `${w}m × ${l}m = ${area} m² (${unitPrice} TL/m²)`,
          subtotal: area * unitPrice,
        });
      } else {
        const qty = Math.max(1, Math.round(Number(qtyInput.value) || 1));
        entries.push({
          id: `${option.value}-${Date.now()}`,
          name,
          detail: `${qty} ${unitLabel} × ${unitPrice} TL`,
          subtotal: qty * unitPrice,
        });
      }

      render();
    });

    clearBtn.addEventListener('click', () => {
      entries = [];
      render();
    });

    syncUnitFields();
  })();
</script>
