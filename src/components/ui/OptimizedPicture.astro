---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Otomatik AVIF + WebP + Responsive Srcset Görsel Bileşeni
 *
 * - priority={true}: Hero/LCP görselleri için eager yükleme ve high fetchpriority
 * - priority={false}: Ekran altı görseller için lazy yükleme ve async decoding
 * - Width/height otomatik atanarak Cumulative Layout Shift (CLS) sıfırlanır
 */
export interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  priority?: boolean;
  quality?: number;
  class?: string;
  pictureClass?: string;
}

const {
  src,
  alt,
  widths = [400, 768, 1200],
  sizes = '(max-width: 768px) 100vw, 50vw',
  priority = false,
  quality = 80,
  class: imgClass = '',
  pictureClass = '',
} = Astro.props;
---

<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  widths={widths}
  sizes={sizes}
  quality={quality}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : 'auto'}
  pictureAttributes={{ class: pictureClass }}
  class={imgClass}
/>
